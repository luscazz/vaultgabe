# Copie este arquivo para ".env" e preencha com os valores reais.
# O arquivo .env NUNCA deve ser enviado ao GitHub.

# Banco de DESENVOLVIMENTO (branch "development" no Neon).
# E o que a aplicacao usa quando roda no seu computador.
# No Neon: botao Connect > branch development > copiar a connection string
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/NOME_DO_BANCO?sslmode=require

# Banco de PRODUCAO (branch principal no Neon: "production" ou "main").
# E o banco do site publicado; no Render ele vira o DATABASE_URL.
# Tambem lida por banco:dev e test:neon, so para recusarem rodar na producao.
DATABASE_URL_PRODUCAO=postgresql://USUARIO:SENHA@HOST/NOME_DO_BANCO?sslmode=require

# Porta do servidor local (o Render define a sua propria automaticamente)
PORT=3000
